# Server
PORT=3001

# Optional: pre-seed config on first boot instead of using the Settings UI.
# All of these can also be set (and edited) from the frontend Settings page,
# which persists them to backend/data/config.json (gitignored).
# Jira and Bitbucket use separate API tokens.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_STORY_POINTS_FIELD=customfield_10016
BITBUCKET_WORKSPACE=
BITBUCKET_API_TOKEN=

# AI agent used by the "AI Review" tab. Provider is one of: claude, codex, cursor.
# AI_MODEL is optional — leave blank to use the provider's default.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Claude only: set to "true" to authenticate via an `ant auth login` OAuth profile on this
# machine (a Claude Pro/Max seat) instead of AI_API_KEY, avoiding separate API billing.
# Codex and Cursor have no such env toggle — Codex always needs its own OpenAI API key,
# and Cursor keys already draw from the same plan as your Cursor subscription.
AI_USE_CLAUDE_SUBSCRIPTION=

# Optional: parent folder of local git clones for AI Review (Settings → advanced).
# REQUIRED for the AI Review tab — commit diffs are read only via `git show` on this machine, not Bitbucket API.
# Clone each repo to {LOCAL_REPO_ROOT}/{repo-slug} (or {LOCAL_REPO_ROOT}/{workspace}/{repo-slug}).
LOCAL_REPO_ROOT=

# MCP server exposed at /mcp (Streamable HTTP) so teammates can point their own
# Claude Code at this deployed backend instead of running the project locally.
# Set a shared secret and distribute it out-of-band (not via this repo) — anyone
# with it can call every tool below (read PR/ticket data, trigger a sync).
# Leave blank only for local dev; the server logs a warning if it's unset.
MCP_AUTH_TOKEN=

# Admin dashboard login (separate from the main app, served at /admin/login).
# Defaults below match the app's out-of-the-box admin account — override both,
# plus ADMIN_SESSION_SECRET, in any shared/production deployment.
ADMIN_EMAIL=admin-ai-review@dssolution.jp
ADMIN_PASSWORD=123456
ADMIN_SESSION_SECRET=
