# Server
PORT=3001

# --- Multi-tenant PostgreSQL (required for login / per-user data) ---
# Start: docker compose up -d  (host port 5433 — see docs/local-postgres.md)
DATABASE_URL=postgresql://ai_review:ai_review_local@127.0.0.1:5433/ai_review
# openssl rand -hex 32
JWT_SECRET=
CONFIG_ENCRYPTION_KEY=
ALLOW_REGISTER=true

# Without DATABASE_URL the app runs single-tenant (shared config.json, no login).

# Optional defaults / seed values (also editable in Settings per user)
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_STORY_POINTS_FIELD=customfield_10016
BITBUCKET_WORKSPACE=
BITBUCKET_API_TOKEN=

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_USE_CLAUDE_SUBSCRIPTION=
LOCAL_REPO_ROOT=

ADMIN_EMAIL=admin-ai-review@dssolution.jp
ADMIN_PASSWORD=123456
ADMIN_SESSION_SECRET=
